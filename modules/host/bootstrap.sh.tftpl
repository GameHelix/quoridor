#!/usr/bin/env bash
# Prepares a Debian or Ubuntu server to run Wickwise services: a deploy user
# with SSH keys, key-only SSH without root, a firewall that lets in only SSH,
# fail2ban, automatic security updates, swap, and Docker with Compose.
# Providers run it at first boot; running it again changes nothing that is
# already right.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

user=${deploy_user}
swap_gb=${swap_gb}

pkg() { apt-get -o DPkg::Lock::Timeout=600 -yq "$@"; }

pkg update
pkg install ca-certificates curl ufw fail2ban unattended-upgrades

# Docker from Docker's repository, which has the Compose plugin for every
# Debian and Ubuntu release.
# shellcheck source=/dev/null
. /etc/os-release
install -m 0755 -d /etc/apt/keyrings
curl -fsSL "https://download.docker.com/linux/$ID/gpg" -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$ID $VERSION_CODENAME stable" >/etc/apt/sources.list.d/docker.list
pkg update
pkg install docker-ce docker-ce-cli containerd.io docker-compose-plugin

# Container logs rotate, so a service that runs for months cannot fill the
# disk. Docker restarts only when this changes.
mkdir -p /etc/docker
echo '{"log-driver": "local", "log-opts": {"max-size": "20m", "max-file": "5"}}' >/tmp/daemon.json
if ! cmp -s /tmp/daemon.json /etc/docker/daemon.json; then
  mv /tmp/daemon.json /etc/docker/daemon.json
  systemctl restart docker
fi
systemctl enable --now docker

# The deploy user runs the services and administers the server.
id "$user" >/dev/null 2>&1 || useradd --create-home --shell /bin/bash "$user"
usermod -aG docker "$user"
install -d -m 700 -o "$user" -g "$user" "/home/$user/.ssh"
cat >"/home/$user/.ssh/authorized_keys" <<'KEYS'
%{ for key in ssh_public_keys ~}
${key}
%{ endfor ~}
KEYS
chown "$user:$user" "/home/$user/.ssh/authorized_keys"
chmod 600 "/home/$user/.ssh/authorized_keys"
echo "$user ALL=(ALL) NOPASSWD:ALL" >"/etc/sudoers.d/90-$user"
chmod 440 "/etc/sudoers.d/90-$user"
install -d -m 755 -o "$user" -g "$user" /srv

# Keys only, and no root. The first file read wins, so this one comes first.
cat >/etc/ssh/sshd_config.d/10-wickwise.conf <<'SSHD'
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
SSHD
# On first boot sshd has not run yet, so its runtime directory is missing.
install -d -m 755 /run/sshd
sshd -t
systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true

# Only SSH comes in, and only from the admin networks. Rules from an earlier
# run are replaced; other rules on the server are left alone.
ufw default deny incoming
ufw default allow outgoing
while n=$(ufw status numbered | awk -F'[][]' '/wickwise-ssh/ {print $2 + 0; exit}') && [ -n "$n" ]; do
  ufw --force delete "$n" >/dev/null
done
%{ for cidr in admin_cidrs ~}
ufw allow from ${cidr} to any port 22 proto tcp comment wickwise-ssh
%{ endfor ~}
ufw --force enable
systemctl enable --now fail2ban

cat >/etc/apt/apt.conf.d/20auto-upgrades <<'APT'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT
timedatectl set-ntp true || true

if [ "$swap_gb" -gt 0 ] && [ -z "$(swapon --show --noheadings)" ]; then
  fallocate -l "$${swap_gb}G" /swapfile
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi

echo "wickwise: host ready"
